{
  "name": "bank-statement-dashboard",
  "version": "0.1.0",
  "description": "Offline spending dashboard from bank statement exports. Runs entirely in the browser.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "serve": "node scripts/serve.mjs",
    "samples": "node scripts/make-samples.mjs",
    "build": "node scripts/build.mjs",
    "build:demo": "node scripts/build.mjs --with-samples --out dist/demo.html",
    "check": "node scripts/render-check.mjs dist/dashboard.html"
  }
}
